// Reusable widgets for the settings window.
//
// Hand-written instead of std-widgets so the settings UI can share the overlay's
// palette, radii and motion rules. The app runs on the winit software renderer,
// which has no element transforms: every "zoomed" state below is expressed by
// animating x / y / width / height / colours instead.

export global Palette {
    out property <color> bg: #0e1014;
    out property <color> panel: #14161c;
    out property <color> card: #191c24;
    out property <color> card-hover: #1f2430;
    out property <color> field: #0b0d11;
    out property <color> line: #ffffff12;
    out property <color> line-strong: #ffffff1f;
    out property <color> text: #f2f4f8;
    out property <color> dim: #8b93a3;
    out property <color> dim2: #6b7383;
    out property <color> accent: #5b8cff;
    out property <color> accent-hover: #7aa2ff;
    out property <color> accent-soft: #5b8cff24;
    out property <color> danger: #e5484d;
    out property <color> danger-hover: #f26166;

    out property <length> radius-card: 14px;
    out property <length> radius-ctl: 9px;
    out property <length> pad-page: 24px;
    out property <length> row-h: 44px;
    out property <length> gap-group: 18px;
    out property <length> gap-ctl: 10px;
}

// ---------------- text ----------------

export component SLabel inherits Text {
    color: Palette.text;
    font-size: 13px;
    vertical-alignment: center;
}

export component SDimLabel inherits Text {
    color: Palette.dim;
    font-size: 12px;
    vertical-alignment: center;
    wrap: word-wrap;
}

export component STitle inherits Text {
    color: Palette.text;
    font-size: 18px;
    font-weight: 700;
    vertical-alignment: center;
}

export component SSubTitle inherits Text {
    color: Palette.text;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

/// Card heading: 13px semibold.
export component SSection inherits Text {
    color: Palette.text;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

// ---------------- buttons ----------------

export component SButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked();

    height: 32px;
    min-width: 72px;
    border-radius: Palette.radius-ctl;
    border-width: 1px;
    border-color: !root.enabled ? #ffffff0a :
        root.primary ? transparent :
        root.danger ? (root.hovered ? #e5484d80 : #e5484d40) :
        (root.hovered ? Palette.line-strong : Palette.line);
    background: !root.enabled ? #ffffff08 :
        root.primary ? (ta.pressed ? #4c79e8 : (root.hovered ? Palette.accent-hover : Palette.accent)) :
        root.danger ? (ta.pressed ? #e5484d26 : (root.hovered ? #e5484d38 : #e5484d1f)) :
        (ta.pressed ? #ffffff0c : (root.hovered ? #ffffff17 : #ffffff0d));
    drop-shadow-color: root.primary && root.enabled ? (root.hovered ? #5b8cff70 : #5b8cff33) : #00000000;
    drop-shadow-blur: root.hovered ? 18px : 10px;
    drop-shadow-offset-y: 3px;

    animate background, border-color, drop-shadow-color, drop-shadow-blur { duration: 120ms; easing: ease-out; }

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Palette.dim2 : root.primary ? #ffffff : root.danger ? Palette.danger-hover : Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        overflow: elide;
        animate color { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// ---------------- toggle ----------------

export component SToggle inherits Rectangle {
    in-out property <bool> checked: false;
    out property <bool> hovered: ta.has-hover;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: root.checked ? (root.hovered ? Palette.accent-hover : Palette.accent)
        : (root.hovered ? #ffffff30 : #ffffff20);
    drop-shadow-color: root.checked ? (root.hovered ? #5b8cff73 : #5b8cff33) : #00000000;
    drop-shadow-blur: root.hovered ? 14px : 8px;
    animate background, drop-shadow-color, drop-shadow-blur { duration: 120ms; easing: ease-out; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 999px;
        background: #ffffff;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 1px;
        animate x { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------- slider ----------------

export component SSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    out property <bool> hovered: ta.has-hover;
    callback changed(float);

    height: 28px;

    // knob grows while hovered / dragged (size animation, no transforms)
    property <length> knob-size: (ta.has-hover || ta.pressed) ? 18px : 14px;
    animate knob-size { duration: 120ms; easing: ease-out; }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 5px;
        border-radius: 999px;
        background: @linear-gradient(180deg, #ffffff26 0%, #ffffff12 100%);
        border-width: 1px;
        border-color: #ffffff0a;
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.value * parent.width;
        height: 5px;
        border-radius: 999px;
        background: @linear-gradient(90deg, #4374ea 0%, Palette.accent 55%, Palette.accent-hover 100%);
        animate width { duration: ta.pressed ? 0ms : 150ms; easing: ease-out; }
    }

    Rectangle {
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        width: root.knob-size;
        height: root.knob-size;
        border-radius: 999px;
        background: #ffffff;
        drop-shadow-color: (ta.has-hover || ta.pressed) ? #5b8cff80 : #00000080;
        drop-shadow-blur: (ta.has-hover || ta.pressed) ? 12px : 6px;
        animate width, height, x, y, drop-shadow-color, drop-shadow-blur { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.value = Math.max(0, Math.min(1, self.mouse-x / root.width));
                root.changed(root.value);
            }
        }
        clicked => {
            root.value = Math.max(0, Math.min(1, self.mouse-x / root.width));
            root.changed(root.value);
        }
    }
}

// ---------------- text field ----------------

export component SLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    out property <bool> focused: ti.has-focus;
    callback accepted(string);
    callback edited(string);

    height: 32px;
    border-radius: Palette.radius-ctl;
    background: ti.has-focus ? #0d1016 : Palette.field;
    border-width: 1px;
    border-color: ti.has-focus ? Palette.accent : Palette.line;
    drop-shadow-color: ti.has-focus ? #5b8cff40 : #00000000;
    drop-shadow-blur: 10px;
    animate background, border-color, drop-shadow-color, drop-shadow-blur { duration: 140ms; easing: ease-out; }

    // The text scrolls inside this box so a long value never spills over the
    // neighbouring controls.
    Rectangle {
        x: 11px;
        y: 0px;
        width: parent.width - 22px;
        height: parent.height;
        clip: true;

        ti := TextInput {
            property <length> computed-x: 0px;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            color: Palette.text;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Palette.accent;
            selection-foreground-color: #ffffff;
            text <=> root.text;
            cursor-position-changed(pos) => {
                if pos.x + self.computed-x < 0px {
                    self.computed-x = -pos.x;
                } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - pos.x - self.text-cursor-width;
                }
            }
            edited => { root.edited(root.text); }
            accepted => { root.accepted(root.text); }
        }
    }

    Text {
        x: 11px;
        y: 0px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.placeholder;
        color: Palette.dim2;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "" && !ti.has-focus;
    }

    // No overlay on purpose: anything covering the field swallows the press and
    // the caret then jumps to the text edge instead of the clicked character.

}

// ---------------- chips ----------------

/// Pill used for route / theme / wheel tabs.
export component SChip inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked();

    height: 32px;
    min-width: 56px;
    border-radius: 999px;
    border-width: 1px;
    border-color: !root.enabled ? transparent :
        root.selected ? Palette.accent :
        root.danger ? (root.hovered ? #e5484d80 : #e5484d40) :
        (root.hovered ? Palette.line-strong : Palette.line);
    background: !root.enabled ? #ffffff08 :
        root.selected ? (root.hovered ? Palette.accent-hover : Palette.accent) :
        root.danger ? (root.hovered ? #e5484d38 : #e5484d1a) :
        (root.hovered ? #ffffff17 : #ffffff0b);
    drop-shadow-color: root.selected ? (root.hovered ? #5b8cff66 : #5b8cff40) : #00000000;
    drop-shadow-blur: root.hovered ? 14px : 8px;
    animate background, border-color, drop-shadow-color, drop-shadow-blur { duration: 120ms; easing: ease-out; }

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Palette.dim2 :
            root.selected ? #ffffff :
            root.danger ? Palette.danger-hover :
            (root.hovered ? Palette.text : Palette.dim);
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        overflow: elide;
        animate color { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// ---------------- colour field ----------------

export component SColorField inherits Rectangle {
    in-out property <string> text: "#000000";
    in property <color> swatch: #000000;
    out property <bool> hovered: back.has-hover;
    callback edited(string);

    height: 32px;
    border-radius: Palette.radius-ctl;
    background: Palette.field;
    border-width: 1px;
    border-color: ti.has-focus ? Palette.accent : (back.has-hover ? Palette.line-strong : Palette.line);
    drop-shadow-color: ti.has-focus ? #5b8cff40 : #00000000;
    drop-shadow-blur: 10px;
    animate border-color, drop-shadow-color, drop-shadow-blur { duration: 140ms; easing: ease-out; }

    back := TouchArea {
        clicked => { ti.focus(); }
    }

    // the swatch grows by 2px on hover (no transforms on this renderer)
    Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: swatch-ta.has-hover ? 26px : 24px;
        height: self.width;
        border-radius: 7px;
        background: root.swatch;
        border-width: 1px;
        border-color: #ffffff40;
        drop-shadow-color: #00000073;
        drop-shadow-blur: 6px;
        animate width, height { duration: 120ms; easing: ease-out; }
    }

    swatch-ta := TouchArea {
        mouse-cursor: pointer;
    }

    ti := TextInput {
        x: 38px;
        y: 0px;
        width: parent.width - 48px;
        height: parent.height;
        color: Palette.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        edited => { root.edited(root.text); }
        accepted => { root.edited(root.text); }
    }

    Text {
        x: 38px;
        y: 0px;
        width: parent.width - 48px;
        height: parent.height;
        text: "#RRGGBB";
        color: Palette.dim2;
        font-size: 13px;
        vertical-alignment: center;
        visible: root.text == "" && !ti.has-focus;
    }
}

// ---------------- layout helpers ----------------

/// One settings row: fixed label column on the left, controls stretch to the
/// right edge so cards are filled instead of leaving dead space.
export component SRow inherits Rectangle {
    in property <string> label: "";
    in property <length> label-width: 104px;
    /// Dims the whole row (e.g. a group that is currently switched off).
    in property <float> dim: 1.0;

    height: Palette.row-h;
    opacity: root.dim;
    animate opacity { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        spacing: 16px;
        cross-axis-alignment: center;

        Text {
            width: root.label-width;
            height: parent.height;
            text: root.label;
            color: Palette.text;
            opacity: 0.86;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        @children
    }
}

/// Rounded card that groups settings; optional 13px heading.
export component SCard inherits Rectangle {
    in property <string> title: "";
    in property <color> edge: Palette.line;
    in property <length> pad: 16px;

    border-radius: Palette.radius-card;
    // very light top-down gradient so cards read as glass instead of flat blocks
    background: @linear-gradient(180deg, #1c2029 0%, #181b22 100%);
    border-width: 1px;
    border-color: root.edge;

    VerticalLayout {
        padding: root.pad;
        spacing: 14px;

        if root.title != "" : SSection {
            height: 18px;
            text: root.title;
        }

        @children
    }
}
