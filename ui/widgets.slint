// Reusable lightweight widgets for the settings toolbox.
// Written by hand instead of std-widgets to keep the binary and memory small
// and to keep the look consistent.

export global Palette {
    out property <color> bg: #16171d;
    out property <color> panel: #1c1e26;
    out property <color> card: #20222b;
    out property <color> field: #0f1015;
    out property <color> line: #ffffff14;
    out property <color> text: #ffffff;
    out property <color> dim: #8d93a1;
    out property <color> accent: #3d7bfd;
    out property <color> accent-hover: #5589ff;
    out property <color> danger: #cf3b41;
}

export component SLabel inherits Text {
    color: Palette.text;
    font-size: 13px;
    vertical-alignment: center;
}

export component SDimLabel inherits Text {
    color: Palette.dim;
    font-size: 12px;
    vertical-alignment: center;
    wrap: word-wrap;
}

export component STitle inherits Text {
    color: Palette.text;
    font-size: 17px;
    font-weight: 700;
    vertical-alignment: center;
}

export component SSubTitle inherits Text {
    color: Palette.text;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

export component SButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    min-width: 76px;
    border-radius: 7px;
    background: !root.enabled ? #ffffff10
        : root.primary ? (ta.has-hover ? Palette.accent-hover : Palette.accent)
        : root.danger ? (ta.has-hover ? #e5545a : Palette.danger)
        : (ta.has-hover ? #343849 : #2a2d3a);

    Text {
        text: root.text;
        color: root.enabled ? Palette.text : #ffffff55;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component SToggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Palette.accent : #ffffff26;
    animate background { duration: 130ms; }

    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        animate x { duration: 130ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component SSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    callback changed(float);

    height: 26px;

    Rectangle {
        y: 11px;
        height: 4px;
        width: 100%;
        border-radius: 2px;
        background: #ffffff26;
        Rectangle {
            width: root.value * parent.width;
            height: 100%;
            border-radius: 2px;
            background: Palette.accent;
        }
    }

    Rectangle {
        x: (root.width - 14px) * root.value;
        y: 6px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 4px;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.value = Math.max(0, Math.min(1, self.mouse-x / root.width));
                root.changed(root.value);
            }
        }
        clicked => {
            root.value = Math.max(0, Math.min(1, self.mouse-x / root.width));
            root.changed(root.value);
        }
    }
}

export component SLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    callback accepted(string);
    callback edited(string);

    height: 30px;
    border-radius: 7px;
    background: Palette.field;
    border-width: 1px;
    border-color: ti.has-focus ? Palette.accent : Palette.line;

    ti := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        color: Palette.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        edited => { root.edited(root.text); }
        accepted => { root.accepted(root.text); }
    }

    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.placeholder;
        color: Palette.dim;
        font-size: 13px;
        vertical-alignment: center;
        visible: root.text == "" && !ti.has-focus;
    }

    TouchArea {
        clicked => { ti.focus(); }
    }
}

/// Selectable pill used for route / theme / wheel tabs.
export component SChip inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback clicked();

    height: 28px;
    min-width: 56px;
    border-radius: 14px;
    background: root.selected ? Palette.accent
        : root.danger ? (ta.has-hover ? #e5545a : #3a2026)
        : (ta.has-hover ? #343849 : #242631);

    Text {
        text: root.text;
        color: Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Color swatch + hex text field.
export component SColorField inherits Rectangle {
    in-out property <string> text: "#000000";
    in property <color> swatch: #000000;
    callback edited(string);

    height: 30px;

    Rectangle {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: root.swatch;
        border-width: 1px;
        border-color: #ffffff40;
    }

    SLineEdit {
        x: 38px;
        width: parent.width - 38px;
        text <=> root.text;
        placeholder: "#RRGGBB";
        edited(t) => { root.edited(t); }
    }
}

/// One settings row: fixed-width label on the left, control on the right.
export component SRow inherits Rectangle {
    in property <string> label: "";
    in property <string> hint: "";
    height: 40px;

    SDimLabel {
        x: 0px;
        width: 150px;
        height: parent.height;
        text: root.label;
        font-size: 13px;
        color: Palette.text;
        opacity: 0.85;
    }

    @children
}
