// Settings toolbox: left rail with pages, right content area.
//
// The rail highlight, the hover states and the page fade are all plain property
// animations (x / y / opacity / colour) because the winit software renderer has
// no element transforms.

import { ScrollView } from "std-widgets.slint";
import { Palette, SButton, SToggle, SSlider, SLineEdit, SChip, SColorField, SDimLabel, STitle, SRow, SCard } from "widgets.slint";

export struct EditItem {
    wheel: int,
    slot: int,
    name: string,
    icon: image,
    has-icon: bool,
    is-list-entry: bool,
    nokeys-id: int,
    // 0 = 虚拟键, 1 = 快捷键, 2 = 程序, 3 = 文本, 4 = 命令, 5 = 网页
    // 0 虚拟键, 1 快捷键, 2 程序, 3 文本, 4 命令, 5 网页
    action-kind: int,
    action-param: string,
    action-args: string,
    // the F-key the virtual-key action sends (F13..F24)
    vk-name: string,
}

// ---------------- rail ----------------

component RailItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <int> index: 0;
    out property <bool> hovered: ta.has-hover;
    callback clicked(int);

    height: 40px;
    border-radius: 10px;
    background: root.active ? transparent : (root.hovered ? #ffffff0a : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: root.active ? 18px : (root.hovered ? 16px : 14px);
        y: 0px;
        width: parent.width - 30px;
        height: parent.height;
        text: root.label;
        color: root.active ? Palette.text : (root.hovered ? #d7dcea : Palette.dim);
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
        animate color, x { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.index); }
    }
}

// ---------------- wheel item row ----------------

// One functional item. Line 1 is its identity, line 2 is what it does, and a
// third line (programs only) holds the command line arguments.
component EditRow inherits Rectangle {
    in property <EditItem> item;
    callback rename(string);
    callback pick-icon();
    callback clear();
    callback set-kind(int);
    callback set-param(string);
    callback set-args(string);
    callback pick-program();

    // 0 虚拟键, 1 程序, 2 文本, 3 命令, 4 网页
    property <bool> is-program: root.item.action-kind == 2;
    property <bool> is-key: root.item.action-kind == 0;
    height: root.is-program ? 114px : 82px;
    property <bool> hot: row-ta.has-hover || icon-btn.hovered || clear-btn.hovered;

    row-ta := TouchArea {
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: root.hot ? #ffffff13 : #ffffff06;
        border-width: 1px;
        border-color: root.hot ? #ffffff24 : transparent;
        animate background, border-color { duration: 120ms; easing: ease-out; }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        // ---- line 1: identity ----
        HorizontalLayout {
            height: 30px;
            spacing: 8px;

            Rectangle {
                width: 22px;
                height: 30px;
                border-radius: 6px;
                background: #ffffff0a;
                border-width: 1px;
                border-color: #ffffff10;

                Text {
                    text: root.item.slot + 1;
                    color: Palette.dim;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.item.has-icon ? transparent : Palette.field;
                border-width: 1px;
                border-color: Palette.line;

                if root.item.has-icon : Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.icon;
                    image-fit: contain;
                }

                if !root.item.has-icon : Path {
                    x: 8px;
                    y: 8px;
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    fit: fill;
                    commands: "M 1 1 H 11 V 11 H 1 Z M 3 9 L 5.6 6.4 L 7.6 8.4 L 9.4 5.9 L 11 7.6";
                    stroke: #ffffff30;
                    stroke-width: 1px;
                    fill: transparent;
                }
            }

            SLineEdit {
                horizontal-stretch: 1;
                height: 30px;
                text: root.item.name;
                placeholder: root.item.is-list-entry ? "列表视图" : "功能名称";
                edited(t) => { root.rename(t); }
            }

            icon-btn := SButton {
                width: 56px;
                height: 30px;
                text: "图标";
                clicked => { root.pick-icon(); }
            }

            clear-btn := SButton {
                width: 52px;
                height: 30px;
                text: "清空";
                danger: true;
                enabled: !root.item.is-list-entry;
                clicked => { root.clear(); }
            }
        }

        // ---- line 2: what it does ----
        HorizontalLayout {
            height: 26px;
            spacing: 6px;

            SDimLabel {
                width: 34px;
                text: "动作";
                font-size: 12px;
            }

            if root.item.is-list-entry : SDimLabel {
                horizontal-stretch: 1;
                text: "— 固定项：打开列表视图 —";
                font-size: 12px;
            }

            if !root.item.is-list-entry : SChip {
                width: 62px;
                height: 26px;
                text: "虚拟键";
                selected: root.item.action-kind == 0;
                clicked => { root.set-kind(0); }
            }
            if !root.item.is-list-entry : SChip {
                width: 62px;
                height: 26px;
                text: "快捷键";
                selected: root.item.action-kind == 1;
                clicked => { root.set-kind(1); }
            }
            if !root.item.is-list-entry : SChip {
                width: 50px;
                height: 26px;
                text: "程序";
                selected: root.item.action-kind == 2;
                clicked => { root.set-kind(2); }
            }
            if !root.item.is-list-entry : SChip {
                width: 50px;
                height: 26px;
                text: "文本";
                selected: root.item.action-kind == 3;
                clicked => { root.set-kind(3); }
            }
            if !root.item.is-list-entry : SChip {
                width: 50px;
                height: 26px;
                text: "命令";
                selected: root.item.action-kind == 4;
                clicked => { root.set-kind(4); }
            }
            if !root.item.is-list-entry : SChip {
                width: 50px;
                height: 26px;
                text: "网页";
                selected: root.item.action-kind == 5;
                clicked => { root.set-kind(5); }
            }

            if !root.item.is-list-entry : SLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.item.action-param;
                placeholder: root.item.action-kind == 0 ? "留空=发 " + root.item.vk-name + "（保留键）；要绑到游戏/软件里就填对方认识的键，如 F8、Ctrl+Alt+M"
                    : root.item.action-kind == 1 ? "要发送的组合，例如 Ctrl+Alt+M、F8"
                    : root.item.action-kind == 2 ? "程序路径"
                    : root.item.action-kind == 3 ? "要键入的文本，可用 {date} {time} {clipboard}"
                    : root.item.action-kind == 4 ? "cmd 命令，例如 shutdown /s /t 0"
                    : "网址，例如 https://example.com";
                edited(t) => { root.set-param(t); }
            }

            if !root.item.is-list-entry && root.is-program : SButton {
                width: 52px;
                height: 26px;
                text: "选择";
                clicked => { root.pick-program(); }
            }
        }

        // ---- line 3: arguments (programs only) ----
        if !root.item.is-list-entry && root.is-program : HorizontalLayout {
            height: 26px;
            spacing: 8px;

            SDimLabel {
                width: 34px;
                text: "参数";
                font-size: 12px;
            }

            SLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.item.action-args;
                placeholder: "启动参数，可留空（不解析引号，按空格切分）";
                edited(t) => { root.set-args(t); }
            }
        }
    }
}
// ---------------- settings window ----------------

export component SettingsWindow inherits Window {
    title: "No Keys - 设置";
    width: 920px;
    height: 640px;
    background: Palette.bg;

    in-out property <int> page: 0;

    // ---- general ----
    in property <string> hotkey-label: "未绑定";
    in-out property <bool> capturing: false;
    /// Why the last pressed key was refused while rebinding (empty = no problem).
    in-out property <string> capture-hint: "";
    /// Briefly true right after a chord was accepted, so a rebind that keeps the
    /// same chord still shows that something happened.
    in-out property <bool> bind-flash: false;
    in-out property <int> route-index: 0;      // 0..wheel-count-1 = wheel, last = list
    in property <int> wheel-count: 1;
    in-out property <bool> blur-enabled: true;
    in-out property <float> blur-strength: 0.5;

    // ---- wheels ----
    in-out property <int> selected-wheel: 0;
    in property <[EditItem]> edit-items;

    // ---- list view ----
    in-out property <bool> list-bg-enabled: false;
    in-out property <string> list-bg-image: "";
    in property <bool> list-bg-image-set: false;
    in-out property <float> list-bg-opacity: 0.5;
    in-out property <float> card-opacity: 0.85;
    in-out property <int> list-columns: 4;

    // ---- animation ----
    in-out property <float> anim-global: 1.0;
    in-out property <float> anim-fade: 1.0;
    in-out property <float> anim-slide: 1.0;
    in-out property <float> anim-hover-fade: 1.0;
    in-out property <float> anim-hover-scale: 1.0;
    in-out property <float> anim-stagger: 1.0;

    // ---- data ----
    in property <string> data-dir: "";

    // Faded from 0 to 1 by the host after a page switch so content animates in.
    in-out property <float> content-alpha: 1.0;

    callback request-capture();
    callback cancel-capture();
    callback page-changed(int);
    callback quit-app();
    callback set-route(int);
    callback set-blur-enabled(bool);
    callback set-blur-strength(float);

    callback select-wheel(int);
    callback add-wheel();
    callback remove-wheel(int);
    callback set-item-name(int, int, string);
    callback pick-item-icon(int, int);
    callback clear-item(int, int);
    callback add-item(int);

    callback set-list-bg-enabled(bool);
    callback pick-list-bg-image();
    callback clear-list-bg-image();
    callback set-list-bg-opacity(float);
    callback set-card-opacity(float);
    callback set-list-columns(int);

    callback set-item-action-kind(int, int, int);
    callback set-item-action-param(int, int, string);
    callback set-item-action-args(int, int, string);
    callback pick-item-program(int, int);

    callback set-anim-global(float);
    callback set-anim-fade(float);
    callback set-anim-slide(float);
    callback set-anim-hover-fade(float);
    callback set-anim-hover-scale(float);
    callback set-anim-stagger(float);

    callback open-data-dir();
    callback clear-all();
    callback preview-wheel();
    callback preview-list();

    // ---- derived ----

    property <length> rail-width: 208px;

    property <string> page-title:
        root.page == 0 ? "通用" :
        root.page == 1 ? "轮盘" :
        root.page == 2 ? "列表视图" :
        root.page == 3 ? "动画" : "数据与清空";

    property <string> page-desc:
        root.page == 0 ? "全局快捷键、路由与毛玻璃外观。" :
        root.page == 1 ? "每个轮盘最多 8 个功能项；少于 8 个时自动均分。轮盘 1 固定带一个“列表视图”项。" :
        root.page == 2 ? "列表视图汇总所有轮盘的功能项：4:3 卡片，图标居中、名称在下，按每行个数从左到右排列。" :
        root.page == 3 ? "全局速度统一缩放所有动画；每个动画还可单独乘以倍数。实际时长 = 基础时长 ÷ (全局 × 倍数)。" :
        "配置与会话数据以 JSON 保存在本机，不上传、不导入导出。";

    property <int> active-page: Math.max(0, Math.min(4, root.page));

    HorizontalLayout {
        // ================= SIDEBAR =================
        Rectangle {
            width: root.rail-width;
            background: Palette.panel;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: 100%;
                background: Palette.line;
            }

            // brand
            Rectangle {
                x: 16px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: @linear-gradient(145deg, #86a8ff 0%, #5b8cff 55%, #3f6fe0 100%);
                drop-shadow-color: #5b8cff4d;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 2px;

                Text {
                    text: "N";
                    color: #ffffff;
                    font-size: 16px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Text {
                x: 58px;
                y: 0px;
                width: parent.width - 72px;
                height: 56px;
                text: "No Keys";
                color: Palette.text;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            // navigation with a sliding highlight block
            Rectangle {
                x: 12px;
                y: 64px;
                width: parent.width - 24px;
                height: 216px;

                Rectangle {
                    y: root.active-page * 44px;
                    width: 100%;
                    height: 40px;
                    border-radius: 10px;
                    background: Palette.accent-soft;
                    border-width: 1px;
                    border-color: #5b8cff33;
                    animate y { duration: 220ms; easing: ease-in-out; }

                    Rectangle {
                        x: 0px;
                        y: (parent.height - 18px) / 2;
                        width: 3px;
                        height: 18px;
                        border-radius: 2px;
                        background: Palette.accent;
                    }
                }

                for nav[i] in ["通用", "轮盘", "列表视图", "动画", "数据与清空"] : RailItem {
                    y: i * 44px;
                    width: 100%;
                    height: 40px;
                    label: nav;
                    index: i;
                    active: root.active-page == i;
                    clicked(p) => {
                        root.page = p;
                        root.page-changed(p);
                    }
                }
            }

            // bottom actions
            Rectangle {
                x: 12px;
                y: parent.height - 148px;
                width: parent.width - 24px;
                height: 132px;

                VerticalLayout {
                    spacing: 6px;

                    SButton {
                        height: 34px;
                        text: "预览轮盘";
                        primary: true;
                        clicked => { root.preview-wheel(); }
                    }
                    SButton {
                        height: 34px;
                        text: "预览列表";
                        clicked => { root.preview-list(); }
                    }
                    Rectangle {
                        height: 12px;
                        background: transparent;
                        Rectangle {
                            y: 6px;
                            width: 100%;
                            height: 1px;
                            background: Palette.line;
                        }
                    }
                    SButton {
                        height: 34px;
                        text: "退出";
                        danger: true;
                        clicked => { root.quit-app(); }
                    }
                }
            }
        }

        // ================= CONTENT =================
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            opacity: root.content-alpha;
            animate opacity { duration: 150ms; easing: ease-out; }

            // fixed page header
            Rectangle {
                y: 0px;
                width: 100%;
                height: 76px;

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 30px;
                    padding-top: 16px;
                    padding-bottom: 14px;
                    spacing: 3px;

                    STitle {
                        height: 26px;
                        text: root.page-title;
                    }

                    Text {
                        height: 17px;
                        text: root.page-desc;
                        color: Palette.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Palette.line;
                }
            }

            // scrolling body
            Rectangle {
                y: 76px;
                width: 100%;
                height: parent.height - 76px;
                clip: true;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    content-width: self.width;
                    // The Flickable derives its content height from the child's
                    // minimum height, which layouts report as zero for stretched
                    // children. Measuring the page in a rectangle keeps long pages
                    // scrollable instead of clipped.
                    content-height: pane.height;

                    pane := Rectangle {
                        width: 100%;
                        height: body.preferred-height;

                        body := VerticalLayout {
                            padding-left: 24px;
                            padding-right: 30px;
                            padding-top: 20px;
                            padding-bottom: 26px;
                            spacing: 18px;

                            // ============ GENERAL ============
                            if root.page == 0 : VerticalLayout {
                                spacing: 18px;

                                SCard {
                                    title: "快捷键";

                                    SDimLabel {
                                        text: "单键可用 F1–F24 / Pause / ScrollLock / 媒体键；鼠标中键与侧键可直接绑定；字母、数字、符号需配 Ctrl / Alt / Win。";
                                    }

                                    SRow {
                                        label: "全局快捷键";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            cross-axis-alignment: center;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 32px;
                                                border-radius: Palette.radius-ctl;
                                                background: Palette.field;
                                                border-width: 1px;
                                                border-color: root.capturing
                                                    ? (root.capture-hint == "" ? Palette.accent : Palette.danger)
                                                    : root.bind-flash ? Palette.accent : Palette.line;
                                                drop-shadow-color: root.capturing ? #5b8cff40 : root.bind-flash ? #5b8cff26 : #00000000;
                                                drop-shadow-blur: 10px;
                                                animate border-color, drop-shadow-color, drop-shadow-blur { duration: 150ms; easing: ease-out; }

                                                Text {
                                                    x: 12px;
                                                    y: 0px;
                                                    width: parent.width - 24px;
                                                    height: parent.height;
                                                    text: root.capturing
                                                        ? (root.capture-hint == "" ? "请按下按键…（Esc 取消）" : root.capture-hint)
                                                        : (root.bind-flash ? "已绑定  " + root.hotkey-label : root.hotkey-label);
                                                    color: root.capturing
                                                        ? (root.capture-hint == "" ? Palette.accent : Palette.danger)
                                                        : (root.bind-flash ? Palette.accent : Palette.text);
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    animate color { duration: 150ms; }
                                                }

                                                // The field is the obvious thing to
                                                // click, so it starts the capture as
                                                // well instead of only the button.
                                                field-ta := TouchArea {
                                                    mouse-cursor: root.capturing ? default : pointer;
                                                    clicked => {
                                                        if (!root.capturing) {
                                                            root.request-capture();
                                                        }
                                                    }
                                                }
                                            }

                                            SButton {
                                                width: 88px;
                                                height: 32px;
                                                text: root.capturing ? "取消" : "改绑";
                                                primary: !root.capturing;
                                                clicked => {
                                                    if (root.capturing) {
                                                        root.cancel-capture();
                                                    } else {
                                                        root.request-capture();
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "打开方式";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            cross-axis-alignment: center;

                                            for n in root.wheel-count : SChip {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                text: "轮盘 " + (n + 1);
                                                selected: root.route-index == n;
                                                clicked => { root.set-route(n); }
                                            }

                                            SChip {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                text: "列表视图";
                                                selected: root.route-index == root.wheel-count;
                                                clicked => { root.set-route(root.wheel-count); }
                                            }
                                        }
                                    }
                                }

                                SCard {
                                    title: "外观";


                                    SRow {
                                        label: "毛玻璃";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            alignment: end;
                                            cross-axis-alignment: center;

                                            SToggle {
                                                checked: root.blur-enabled;
                                                toggled(v) => { root.set-blur-enabled(v); }
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "强度";
                                        dim: root.blur-enabled ? 1.0 : 0.45;

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: root.blur-strength;
                                                changed(v) => { root.set-blur-strength(v); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.blur-strength * 100) + "%";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }

                                }
                            }

                            // ============ WHEELS ============
                            if root.page == 1 : VerticalLayout {
                                spacing: 18px;

                                SCard {
                                    title: "轮盘";

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            cross-axis-alignment: center;

                                            for n in root.wheel-count : SChip {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                text: "轮盘 " + (n + 1);
                                                selected: root.selected-wheel == n;
                                                clicked => { root.select-wheel(n); }
                                            }
                                        }

                                        SButton {
                                            width: 84px;
                                            text: "+ 新增";
                                            clicked => { root.add-wheel(); }
                                        }
                                        SButton {
                                            width: 72px;
                                            text: "删除";
                                            danger: true;
                                            enabled: root.wheel-count > 1;
                                            clicked => { root.remove-wheel(root.selected-wheel); }
                                        }
                                    }
                                }

                                SCard {
                                    title: "功能项";

                                    VerticalLayout {
                                        spacing: 0px;

                                        for item[i] in root.edit-items : Rectangle {
                                            // 84px for two lines, 118px when the item is a program
                                            // (the third line holds its arguments)
                                            height: item.wheel == root.selected-wheel ? (item.action-kind == 2 ? 122px : 90px) : 0px;

                                            if item.wheel == root.selected-wheel : EditRow {
                                                y: 0px;
                                                width: parent.width;
                                                height: item.action-kind == 2 ? 114px : 82px;
                                                item: item;
                                                rename(t) => { root.set-item-name(item.wheel, item.slot, t); }
                                                pick-icon => { root.pick-item-icon(item.wheel, item.slot); }
                                                clear => { root.clear-item(item.wheel, item.slot); }
                                                set-kind(k) => { root.set-item-action-kind(item.wheel, item.slot, k); }
                                                set-param(p) => { root.set-item-action-param(item.wheel, item.slot, p); }
                                                set-args(a) => { root.set-item-action-args(item.wheel, item.slot, a); }
                                                pick-program => { root.pick-item-program(item.wheel, item.slot); }
                                            }
                                        }
                                    }

                                    if root.edit-items.length == 0 : SDimLabel {
                                        height: 36px;
                                        text: "此轮盘还没有功能项，添加后会分配一个新的 nokeys 序号。";
                                    }

                                    SButton {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        text: "+ 添加功能项";
                                        enabled: root.edit-items.length < root.wheel-count * 8;
                                        clicked => { root.add-item(root.selected-wheel); }
                                    }
                                }
                            }

                            // ============ LIST VIEW ============
                            if root.page == 2 : VerticalLayout {
                                spacing: 18px;

                                SCard {
                                    title: "背景";

                                    SRow {
                                        label: "启用背景";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            alignment: end;
                                            cross-axis-alignment: center;

                                            SToggle {
                                                checked: root.list-bg-enabled;
                                                toggled(v) => { root.set-list-bg-enabled(v); }
                                            }
                                        }
                                    }


                                    SRow {
                                        label: "背景图片";
                                        dim: root.list-bg-enabled ? 1.0 : 0.45;

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            cross-axis-alignment: center;

                                            SDimLabel {
                                                horizontal-stretch: 1;
                                                text: root.list-bg-image-set ? root.list-bg-image : "未选择";
                                                wrap: no-wrap;
                                                overflow: elide;
                                            }

                                            SButton {
                                                width: 72px;
                                                text: "选择";
                                                enabled: root.list-bg-enabled;
                                                clicked => { root.pick-list-bg-image(); }
                                            }
                                            SButton {
                                                width: 64px;
                                                text: "移除";
                                                enabled: root.list-bg-enabled && root.list-bg-image-set;
                                                clicked => { root.clear-list-bg-image(); }
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "背景透明度";
                                        dim: root.list-bg-enabled ? 1.0 : 0.45;

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: root.list-bg-opacity;
                                                changed(v) => { root.set-list-bg-opacity(v); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.list-bg-opacity * 100) + "%";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                SCard {
                                    title: "功能项卡片";

                                    SRow {
                                        label: "每行个数";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            cross-axis-alignment: center;

                                            for n in 7 : SChip {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                text: n + 2;
                                                selected: root.list-columns == n + 2;
                                                clicked => { root.set-list-columns(n + 2); }
                                            }
                                        }
                                    }


                                    SRow {
                                        label: "卡片不透明度";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: root.card-opacity;
                                                changed(v) => { root.set-card-opacity(v); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.card-opacity * 100) + "%";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }

                            // ============ ANIMATION ============
                            if root.page == 3 : VerticalLayout {
                                spacing: 18px;

                                SCard {
                                    title: "速度";

                                    SRow {
                                        label: "全局速度";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-global - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-global(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-global * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                SCard {
                                    title: "单项倍数";

                                    SRow {
                                        label: "淡入淡出";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-fade - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-fade(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-fade * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "位移";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-slide - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-slide(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-slide * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "悬停淡出";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-hover-fade - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-hover-fade(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-hover-fade * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "悬停放大";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-hover-scale - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-hover-scale(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-hover-scale * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }

                                    SRow {
                                        label: "列表依次弹出";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            SSlider {
                                                horizontal-stretch: 1;
                                                value: (root.anim-stagger - 0.25) / 3.75;
                                                changed(v) => { root.set-anim-stagger(v * 3.75 + 0.25); }
                                            }

                                            SDimLabel {
                                                width: 44px;
                                                text: Math.round(root.anim-stagger * 100) / 100 + "x";
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }

                            // ============ DATA ============
                            if root.page == 4 : VerticalLayout {
                                spacing: 18px;

                                SCard {
                                    title: "存储";

                                    SRow {
                                        label: "配置目录";

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            cross-axis-alignment: center;

                                            SDimLabel {
                                                horizontal-stretch: 1;
                                                text: root.data-dir;
                                                wrap: no-wrap;
                                                overflow: elide;
                                            }

                                            SButton {
                                                width: 96px;
                                                text: "打开目录";
                                                clicked => { root.open-data-dir(); }
                                            }
                                        }
                                    }
                                }

                                SCard {
                                    title: "危险操作";
                                    edge: #e5484d33;

                                    SDimLabel {
                                        text: "清空会删除所有轮盘、功能项、图标与全部设置，并注销所有 nokeys 序号。";
                                    }

                                    SButton {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        text: "清空全部数据";
                                        danger: true;
                                        clicked => { root.clear-all(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}