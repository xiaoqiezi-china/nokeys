// Overlay window: radial wheel view and flat list view.

// ---- data models ----

export struct WheelItem {
    id: int,
    name: string,
    icon: image,
    has-icon: bool,
    // SVG path commands of the pie sector (pixel coords inside the disc box)
    path: string,
    // center of the icon+label content in the wheel view
    cx: length,
    cy: length,
}

export struct ListItem {
    id: int,
    name: string,
    icon: image,
    has-icon: bool,
    // target y position of the card in the list view
    cy: length,
}

// ---- overlay (wheel + list) ----

export component OverlayWindow inherits Window {
    title: "NoKeys Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <bool> show-wheel: true;
    in property <int> hovered: -1;
    in property <int> wheel-index: 1;
    in property <bool> reveal: false;

    in property <color> disc-tint: #3a3f4ecc;
    in property <color> disc-tint-2: #171a22e0;
    in property <color> disc-border: #ffffff1f;
    in property <color> sector-stroke: #ffffff26;
    in property <color> sector-hover: #ffffff2e;
    in property <color> text-color: #ffffff;
    in property <color> card-bg: #22242ed8;
    in property <color> sub-text-color: #ffffffb0;
    in property <color> close-bg: #ffffff14;
    in property <color> close-hover-bg: #ff5a5f66;
    in property <color> icon-ph-bg: #ffffff1a;
    in property <color> icon-ph-line: #ffffff66;
    in property <color> chip-bg: #00000038;
    in property <color> disc-halo: #0000001a;

    in property <image> disc-image;
    in property <bool> disc-image-set: false;
    in property <color> blur-tint: #1f243099;
    in property <color> blur-tint-2: #171a22aa;

    in property <bool> list-bg-enabled: false;
    in property <color> list-bg-color: #1e1e2e;
    in property <float> list-bg-opacity: 0.5;
    in property <image> list-bg-image;
    in property <bool> list-bg-image-set: false;

    in property <duration> fade-dur: 150ms;
    in property <duration> slide-dur: 220ms;
    in property <duration> hover-dur: 130ms;
    in property <duration> stagger-dur: 45ms;

    in property <[WheelItem]> wheel-items;
    in property <[ListItem]> list-items;

    callback activate(int);
    callback close-requested();
    callback hover-at(length, length);
    callback click-at(length, length);

    // ================= WHEEL =================
    if root.show-wheel : Rectangle {
        width: parent.width;
        height: parent.height;

        // full-window area for hover/click detection (behind the X button)
        hover-area := TouchArea {
            moved => { root.hover-at(self.mouse-x, self.mouse-y); }
            clicked => { root.click-at(self.mouse-x, self.mouse-y); }
        }

        wheel-group := Rectangle {
            x: 0px;
            y: root.reveal ? 0px : 48px;
            width: parent.width;
            height: parent.height;
            opacity: root.reveal ? 1.0 : 0.0;

            animate y { duration: root.slide-dur; easing: ease-out; }
            animate opacity { duration: root.fade-dur; easing: ease-out; }

            // soft halo so the disc separates from busy desktops
            Rectangle {
                x: 34px;
                y: 34px;
                width: 412px;
                height: 412px;
                border-radius: 206px;
                background: root.disc-halo;
            }

            // frosted disc base
            disc := Rectangle {
                x: 40px;
                y: 40px;
                width: 400px;
                height: 400px;
                border-radius: 200px;
                clip: true;
                background: root.disc-tint;
                border-width: 1px;
                border-color: root.disc-border;
                drop-shadow-color: #00000055;
                drop-shadow-blur: 28px;
                drop-shadow-offset-y: 8px;

                // blurred desktop captured behind the overlay
                if root.disc-image-set : Image {
                    width: 100%;
                    height: 100%;
                    source: root.disc-image;
                    image-fit: fill;
                }
                // configurable tint over the blurred backdrop
                if root.disc-image-set : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, root.blur-tint 0%, root.blur-tint-2 100%);
                }
            }

            // pie sectors
            for item[i] in root.wheel-items : Path {
                x: 40px;
                y: 40px;
                width: 400px;
                height: 400px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 400;
                viewbox-height: 400;
                fit: fill;
                commands: item.path;
                fill: i == root.hovered ? root.sector-hover : transparent;
                stroke: root.sector-stroke;
                stroke-width: 1px;
                animate fill { duration: root.hover-dur; }
            }

            // item content (icon + label), above the sectors.
            // Scaling is done by animating the box size around its centre, because the
            // software renderer (chosen for low memory) does not support transforms.
            for item[i] in root.wheel-items : Rectangle {
                x: item.cx - self.width / 2;
                y: item.cy - self.height / 2;
                width: i == root.hovered ? 118px : 104px;
                height: i == root.hovered ? 84px : 72px;
                opacity: i == root.hovered ? 0.72 : 1.0;
                animate width, height, x, y { duration: root.hover-dur; easing: ease-out; }
                animate opacity { duration: root.hover-dur; }

                // small card behind the icon + label (no big backdrop)
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 16px;
                    background: root.chip-bg;
                }

                // icon
                if item.has-icon : Image {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: i == root.hovered ? 40px : 36px;
                    height: i == root.hovered ? 40px : 36px;
                    source: item.icon;
                    image-fit: contain;
                    animate width, height, x { duration: root.hover-dur; easing: ease-out; }
                }
                if !item.has-icon : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: i == root.hovered ? 40px : 36px;
                    height: i == root.hovered ? 40px : 36px;
                    border-radius: 10px;
                    background: root.icon-ph-bg;
                    border-width: 1px;
                    border-color: root.icon-ph-line;
                    animate width, height, x { duration: root.hover-dur; easing: ease-out; }

                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        fit: fill;
                        commands: "M 4 2 L 12 2 L 16 6 L 16 16 L 2 16 L 2 2 Z";
                        stroke: root.icon-ph-line;
                        stroke-width: 1.4px;
                        fill: transparent;
                    }
                }

                Text {
                    x: 2px;
                    y: parent.height - 24px;
                    width: parent.width - 4px;
                    height: 18px;
                    text: item.name;
                    color: root.text-color;
                    horizontal-alignment: center;
                    font-size: 13px;
                    overflow: elide;
                    animate y { duration: root.hover-dur; easing: ease-out; }
                }
            }

            // center X (manual close)
            x-button := Rectangle {
                x: 216px;
                y: 216px;
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: x-ta.has-hover ? root.close-hover-bg : root.close-bg;
                border-width: 1px;
                border-color: root.disc-border;
                animate background { duration: root.hover-dur; }

                Path {
                    x: 14px;
                    y: 14px;
                    width: 20px;
                    height: 20px;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    fit: fill;
                    commands: "M 5 5 L 15 15 M 15 5 L 5 15";
                    stroke: root.text-color;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                }

                x-ta := TouchArea {
                    clicked => { root.close-requested(); }
                    mouse-cursor: pointer;
                }
            }

            // wheel index number (floating, below the disc)
            Text {
                x: 0px;
                y: 448px;
                width: parent.width;
                height: 26px;
                text: root.wheel-index;
                color: root.text-color;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 15px;
                font-weight: 600;
            }
        }
    }

    // ================= LIST =================
    if !root.show-wheel : Rectangle {
        width: parent.width;
        height: parent.height;

        // empty area click -> close
        empty-ta := TouchArea {
            clicked => { root.close-requested(); }
        }

        // optional background
        if root.list-bg-enabled : Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.list-bg-color;
            opacity: root.list-bg-opacity;
        }
        if root.list-bg-enabled && root.list-bg-image-set : Image {
            width: parent.width;
            height: parent.height;
            source: root.list-bg-image;
            opacity: root.list-bg-opacity;
            image-fit: cover;
        }

        for item[i] in root.list-items : Rectangle {
            x: 36px;
            y: root.reveal ? item.cy : item.cy + 24px;
            width: parent.width - 72px;
            height: 46px;
            opacity: root.reveal ? 1.0 : 0.0;
            animate y { duration: root.slide-dur; delay: i * root.stagger-dur; easing: ease-out; }
            animate opacity { duration: root.fade-dur; delay: i * root.stagger-dur; easing: ease-out; }

            card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width + (i == root.hovered ? 10px : 0px);
                height: parent.height + (i == root.hovered ? 6px : 0px);
                border-radius: 12px;
                background: root.card-bg;
                opacity: i == root.hovered ? 0.7 : 1.0;
                animate width, height, x, y { duration: root.hover-dur; easing: ease-out; }
                animate opacity { duration: root.hover-dur; }

                if item.has-icon : Image {
                    x: 10px;
                    y: 5px;
                    width: 36px;
                    height: 36px;
                    source: item.icon;
                    image-fit: contain;
                }
                if !item.has-icon : Rectangle {
                    x: 10px;
                    y: 5px;
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    background: root.icon-ph-bg;
                    border-width: 1px;
                    border-color: root.icon-ph-line;
                }
                Text {
                    x: 56px;
                    width: parent.width - 66px;
                    height: parent.height;
                    text: item.name;
                    color: root.text-color;
                    vertical-alignment: center;
                    font-size: 14px;
                    overflow: elide;
                }
            }

            TouchArea {
                clicked => { root.activate(item.id); }
                mouse-cursor: pointer;
            }
        }
    }
}
